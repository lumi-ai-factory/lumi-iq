# ==============================================================================
# LUMI-IQ Centralized Configuration File
#
# Copy this file to .env (for this directory) or to ~/.lumi-iq/config (global):
#   cp .env.example .env
#   or: cp .env.example ~/.lumi-iq/config
# ==============================================================================

# LUMI HPC Slurm Project Account (e.g. project_<id>)
LUMI_PROJECT=your_lumi_project_id

# LEXIS Platform Project Short Name (e.g. vlq_demo_project or your allocated project)
LEXIS_PROJECT=vlq_demo_project

# LEXIS Accounting Resource / QPU Backend
LEXIS_RESOURCE=VLQ-CZ
